rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Users collection rules: Authenticated users can read user profiles, but write only their own
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isUser(uid);
    }

    // Short User ID lookup mapping collection rules:
    // Read allowed for any authenticated user searching for a Chat ID.
    // Create/update allowed only for mapping matching own authenticated UID.
    match /userIds/{shortUserId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Conversations collection rules:
    // Read allowed if document doesn't exist yet (checking for creation) or if user is in participants.
    // Update allowed only if authenticated user is listed in participants array.
    // Creation allowed only for 2-participant array containing authenticated user.
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participants);
      allow update: if isAuthenticated() && resource != null && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated()
                   && request.resource.data.participants.size() == 2
                   && (request.auth.uid in request.resource.data.participants);

      // Messages subcollection rules:
      // Read allowed if authenticated user is part of parent conversation.
      // Message creation allowed only if senderId matches authenticated UID and user is participant.
      // Status update allowed for receiver (marking 'seen') or original sender.
      match /messages/{messageId} {
        allow read: if isAuthenticated() 
                     && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow create: if isAuthenticated()
                     && request.resource.data.senderId == request.auth.uid
                     && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow update: if isAuthenticated()
                     && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
                     && (
                       (request.resource.data.receiverId == request.auth.uid && request.resource.data.status == 'seen') ||
                       (resource.data.senderId == request.auth.uid)
                     );
      }
    }
  }
}
